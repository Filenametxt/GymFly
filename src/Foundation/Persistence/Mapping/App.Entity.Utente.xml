<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- Il tag è "entity"
    * i parametri sono name, table e inheritance-type
    * name: il nome completo della classe (namespace + nome)
    * table: il nome della tabella nel database
    * inheritance-type: il tipo di ereditarietà JOINED (si crea una tabella per ogni classe quindi sono cose separate) ci sono le relazioni
    -->
    <entity name="App\Entity\Utente" table="Utente" inheritance-type="JOINED">

        <!-- discriminator: Doctrine capisce quale sottoclasse caricare -->
        <discriminator-column name="tipo" type="string" length="20"/>
        <discriminator-map>
            <discriminator-mapping value="utente"          class="App\Entity\Utente"/>
            <discriminator-mapping value="cliente"         class="App\Entity\Cliente"/>
            <discriminator-mapping value="allenatore"      class="App\Entity\Allenatore"/>
            <discriminator-mapping value="amministratore"  class="App\Entity\Amministratore"/>
        </discriminator-map>

        <!-- Id della tabella che viene generato automaticamnte con Doctrine -->
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <!-- "name" è il nome dell'entità, "colum" è il nome della colonna, "type" è il tipo di dato -->
        <field name="nome"            type="string"  column="nome"/>
        <field name="cognome"         type="string"  column="cognome"/>
        <field name="email"           type="string"  column="email"   unique="true"/>
        <field name="CF"              type="string"  column="CF"      unique="true" length="16"/>
        <field name="profilePicture"  type="blob"    column="profile_picture" nullable="true" length="16777215"/>
        <field name="tipoImmagine" type="string" column="tipoImmagine" nullable="true" length="50"/>
        <field name="telefono"        type="string"  column="telefono"        nullable="true"/>
        <field name="indirizzo"       type="string"  column="indirizzo"       nullable="true"/>
        <field name="sesso"           type="string"  column="sesso"           nullable="true" enum-type="App\Enum\Sesso"/>
        <field name="password"        type="string"  column="password"/>

        <!-- 1-Molti: Utente INVIA molti Messaggi (come mittente) -->
        <!-- campo della classe Utente che rappresenta la relazione con i messaggi inviati
             classe con cui fa la relazione
             chiave esterna nella classe Messaggio che rappresenta la relazione con l'utente -->
        <one-to-many field="messaggiInviati" 
                     target-entity="App\Entity\Messaggio" 
                     mapped-by="mittente"> 
            <cascade> <!-- quando si salva l'oggetto principale, si salvano anche gli oggetti correlati -->
                <cascade-persist/> <!-- quando si salva l'utente, si salvano anche i messaggi inviati -->
            </cascade>
        </one-to-many>

        <!-- Molti-Molti: Utente RICEVE molti Messaggi (tabella RICEVE) -->
        <many-to-many field="messaggiRicevuti" target-entity="App\Entity\Messaggio" inversed-by="destinatari"> <!--viene aggiunto un campo alla classe messaggio. Inversed-by indica che la relazione è bidirezionale e che la classe Messaggio ha un campo destinatari che rappresenta la relazione con gli utenti che ricevono il messaggio -->
            <join-table name="Riceve"> <!-- join chiamato "riceve" che rappresenta la tabella di collegamento tra Utente e Messaggio -->
                <join-columns>
                    <join-column name="id_utente"    referenced-column-name="id"/> <!--dall'utente al messaggio-->
                </join-columns>
                <inverse-join-columns>
                    <join-column name="id_messaggio" referenced-column-name="id"/> <!--dal messaggio all'utente-->
                </inverse-join-columns>
            </join-table>
        </many-to-many>

    </entity>

</doctrine-mapping>