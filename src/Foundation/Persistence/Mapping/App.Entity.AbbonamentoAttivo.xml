<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\AbbonamentoAttivo" table="ABBONAMENTO_ATTIVO">
        
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="dataInizio" type="datetime_immutable" column="data_inizio"/>
        <field name="dataFine" type="datetime_immutable" column="data_fine" nullable="true"/>

        <many-to-one field="abbonamento" target-entity="App\Entity\Abbonamento">
            <join-column name="id_abbonamento" referenced-column-name="id" nullable="false"/>
        </many-to-one>

    </entity>
</doctrine-mapping>