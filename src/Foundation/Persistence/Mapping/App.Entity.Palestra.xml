<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\Palestra" table="Palestra">

        <!-- Chiave primaria -->
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <!-- Attributi -->
        <field name="nome"                column="nome"                type="string"  length="100" nullable="false"/>
        <field name="indirizzo"           column="indirizzo"           type="string"  length="255" nullable="false"/>
        <field name="recapitoTelefonico"  column="recapito_telefonico" type="string"  length="20"  nullable="true"/>
        <field name="email"               column="email"               type="string"  length="150" nullable="true"/>

        <!-- Relazione 1-1 con Amministratore (gestisce) -->
        <!-- Palestra possiede la FK id_amministratore -->
        <one-to-one field="amministratore" target-entity="App\Entity\Amministratore">
            <join-column name="id_amministratore" referenced-column-name="id" nullable="false"/>
        </one-to-one>

    

    </entity>

</doctrine-mapping>