<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\Palestra" table="palestra">

        <!-- Chiave primaria -->
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <!-- Attributi -->
        <field name="nome"                column="nome"                type="string"  length="100" nullable="false"/>
        <field name="indirizzo"           column="indirizzo"           type="string"  length="255" nullable="false"/>
        <field name="recapitoTelefonico"  column="recapito_telefonico" type="string"  length="20"  nullable="true"/>
        <field name="email"               column="email"               type="string"  length="150" nullable="true"/>

        <!-- Relazione 1-1 con Amministratore (gestisce) -->
        <!-- Palestra possiede la FK id_amministratore -->
        <one-to-one field="amministratore" target-entity="Entity\Amministratore">
            <join-column name="id_amministratore" referenced-column-name="id_utente" nullable="false"/>
        </one-to-one>

        <!-- Relazione 1-N con Cliente (iscritto) -->
        <!-- La FK id_palestra è sul lato Cliente -->
        <one-to-many field="clienti" target-entity="Entity\Cliente" mapped-by="palestra"/>

        <!-- Relazione 1-N con Allenatore (lavora) -->
        <!-- La FK id_palestra è sul lato Allenatore -->
        <one-to-many field="allenatori" target-entity="Entity\Allenatore" mapped-by="palestra"/>

        <!-- Relazione 1-N con Sala (contiene) -->
        <!-- La FK id_palestra è sul lato Sala -->
        <one-to-many field="sale" target-entity="Entity\Sala" mapped-by="palestra"/>

    </entity>

</doctrine-mapping>