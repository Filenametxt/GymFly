<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Entity\GruppoMuscolare" table="GruppoMuscolare">
        <id name="id" type="integer" column="id"><generator strategy="AUTO"/></id>
        <field name="nomeGruppoMuscolare" type="string" column="nome_gruppo_muscolare" length="255" nullable="false"/>
        
        <many-to-many field="esercizi" target-entity="App\Entity\Esercizio" mapped-by="gruppiMuscolari"/>
    </entity>
</doctrine-mapping>