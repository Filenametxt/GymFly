<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Entity\Messaggio" table="Messaggio">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="oggetto"   type="string" column="oggetto"/>
        <field name="contenuto" type="text"   column="contenuto"/>

        <!-- Molti-1: molti Messaggi hanno un solo mittente -->
        <many-to-one field="mittente"
                     target-entity="App\Entity\Utente"
                     inversed-by="messaggiInviati">
            <join-column name="id_mittente"
                         referenced-column-name="id"
                         nullable="false"/>
        </many-to-one>

        <!-- Molti-Molti: un Messaggio ha più destinatari (tabella RICEVE) -->
        <!-- "mapped-by" perché il lato owner è Utente.messaggiRicevuti     -->
        <many-to-many field="destinatari"
                      target-entity="App\Entity\Utente"
                      mapped-by="messaggiRicevuti"/>

    </entity>

</doctrine-mapping>