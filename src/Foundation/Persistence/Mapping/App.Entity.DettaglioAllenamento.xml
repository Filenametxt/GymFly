<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
    <entity name="App\Entity\DettaglioAllenamento" table="DETTAGLIO_ALLENAMENTO">
        <id name="id" type="integer" column="id"><generator strategy="AUTO"/></id>
        <field name="serie" type="integer" column="serie" nullable="false"/>
        <field name="ripetizioni" type="integer" column="ripetizioni" nullable="false"/>
        <field name="carico" type="float" column="carico" nullable="false"/>

        <many-to-one field="esercizio" target-entity="App\Entity\Esercizio">
            <join-column name="id_esercizio" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="allenamento" target-entity="App\Entity\Allenamento" inversed-by="dettagli">
            <join-column name="id_allenamento" referenced-column-name="id" on-delete="CASCADE" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>