    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.4",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.6",
        "dompdf/dompdf": "^3.1",
        "smarty/smarty": "^5.8",
        "symfony/cache": "^7.4"
    },

    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
